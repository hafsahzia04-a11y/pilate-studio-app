# ─────────────────────────────────────────────────────────
# SUPABASE — get these from your Supabase project dashboard
# Project Settings → API
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only — never expose this in the frontend!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─────────────────────────────────────────────────────────
# PRISMA — Supabase PostgreSQL connection strings
# Project Settings → Database → Connection string
# Use "Transaction" mode for DATABASE_URL (Vercel serverless)
# Use "Session" mode for DIRECT_URL (Prisma migrations)
# ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_ID:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_ID:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────
# CALLMEBOT WHATSAPP API
# Free — see SETUP.md for how to get your API key
# ─────────────────────────────────────────────────────────
CALLMEBOT_API_KEY=your_callmebot_api_key_here
# Founder's WhatsApp number (with country code, no + sign)
# Example for UAE: 971501234567
FOUNDER_WHATSAPP_PHONE=971501234567

# ─────────────────────────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STUDIO_NAME="The Movement Studio"
# Your timezone — see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
NEXT_PUBLIC_TIMEZONE=Asia/Dubai
